import os
import threading
import time
import customtkinter as ctk
from tkinter import filedialog, messagebox, simpledialog
from tkinterdnd2 import TkinterDnD
from pypdf import PdfReader, PdfWriter
import pandas as pd

# CONFIGURAÇÃO GLOBAL

ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")
BASE_COLOR = "#414141"


# SPLASH SCREEN

class SplashScreen(ctk.CTkToplevel):
    def __init__(self, master, load_callback):
        super().__init__(master)
        self.overrideredirect(True)
        self.configure(fg_color=BASE_COLOR)
        self.load_callback = load_callback

        w, h = 420, 220
        x = (self.winfo_screenwidth() - w) // 2
        y = (self.winfo_screenheight() - h) // 2
        self.geometry(f"{w}x{h}+{x}+{y}")

        ctk.CTkLabel(self, text="Ferramentas PDF", font=("Segoe UI", 22, "bold")).pack(pady=40)
        ctk.CTkLabel(self, text="Desenvolvido por GEABE", font=("Segoe UI", 14), text_color="#B0B0B0").pack()

        self.label_dots = ctk.CTkLabel(self, text="Carregando", font=("Segoe UI", 12))
        self.label_dots.pack(pady=10)

        self.progress = ctk.CTkProgressBar(self, width=350)
        self.progress.set(0)
        self.progress.pack(pady=10)

        self.dots = 0
        self.after(100, self.animate)
        threading.Thread(target=self.load_app, daemon=True).start()

    def animate(self):
        self.dots = (self.dots + 1) % 4
        self.label_dots.configure(text="Carregando" + "." * self.dots)
        self.after(400, self.animate)

    def load_app(self):
        for i in self.load_callback():
            self.progress.set(i)
            time.sleep(0.05)
        self.destroy()

# APLICAÇÃO PRINCIPAL

class PDFToolApp(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master, fg_color=BASE_COLOR)
        self.pack(fill="both", expand=True)

        self.linhas = []
        self.contador_linhas = 0
        self.matriculas_existentes = set()

        self.build_ui()
        ctk.CTkLabel(self, text="GEABE", font=("Arial", 12)).pack(side="bottom", pady=5)

    def build_ui(self):
        self.notebook = ctk.CTkTabview(self)
        self.notebook.pack(fill="both", expand=True, padx=10, pady=10)

        self.tab_unificar = self.notebook.add("Unificar PDFs")
        self.build_tab_unificar()

    # ABA UNIFICAR
    
    def build_tab_unificar(self):
        tab = self.tab_unificar

        self.entry_pasta = ctk.CTkEntry(tab, width=600, placeholder_text="Selecione a pasta raiz")
        self.entry_pasta.pack(pady=10)

        ctk.CTkButton(tab, text="Selecionar Pasta", command=self.selecionar_pasta).pack()

        header = ctk.CTkFrame(tab, fg_color="#363636")
        header.pack(fill="x", padx=10, pady=(10, 0))
        ctk.CTkLabel(header, text="Nº", width=40).grid(row=0, column=0)
        ctk.CTkLabel(header, text="Matrícula", width=200).grid(row=0, column=1)
        ctk.CTkLabel(header, text="Nome PDF", width=200).grid(row=0, column=2)
        ctk.CTkLabel(header, text="Status", width=80).grid(row=0, column=3)
        ctk.CTkLabel(header, text="Remover", width=60).grid(row=0, column=4)

        self.frame_lista = ctk.CTkScrollableFrame(tab, height=300)
        self.frame_lista.pack(fill="x", padx=10)

        self.progress = ctk.CTkProgressBar(tab, width=600)
        self.progress.set(0)
        self.progress.pack(pady=5)

        btns = ctk.CTkFrame(tab)
        btns.pack(pady=10)

        ctk.CTkButton(btns, text="➕ Adicionar Matrícula", command=self.adicionar_linha).grid(row=0, column=0, padx=10)
        ctk.CTkButton(btns, text="📄 Importar Excel", fg_color="#646464", command=self.importar_excel).grid(row=0, column=1, padx=10)
        ctk.CTkButton(btns, text="🔄 Reset", command=self.reset_unificar).grid(row=0, column=2, padx=10)

        ctk.CTkButton(tab, text="✅ UNIFICAR PDFs", fg_color="green", command=self.unificar_thread).pack(pady=10)

    # FUNÇÕES

    def selecionar_pasta(self):
        pasta = filedialog.askdirectory()
        if pasta:
            self.entry_pasta.delete(0, "end")
            self.entry_pasta.insert(0, pasta)

    def adicionar_linha(self, matricula="", nome=""):
        matricula = matricula.strip()
        if matricula and matricula in self.matriculas_existentes:
            return

        self.contador_linhas += 1
        linha = ctk.CTkFrame(self.frame_lista)
        linha.pack(fill="x", pady=3)

        ctk.CTkLabel(linha, text=str(self.contador_linhas), width=40).grid(row=0, column=0)

        mat = ctk.CTkEntry(linha, width=200)
        mat.grid(row=0, column=1, padx=5)
        mat.insert(0, matricula)

        out = ctk.CTkEntry(linha, width=200)
        out.grid(row=0, column=2, padx=5)
        out.insert(0, nome)

        status = ctk.CTkLabel(linha, text="⚪", width=80)
        status.grid(row=0, column=3)

        ctk.CTkButton(
            linha, text="X", width=40, fg_color="#b22222",
            command=lambda f=linha: self.remover_linha(f)
        ).grid(row=0, column=4)

        self.linhas.append((linha, mat, out, status))
        if matricula:
            self.matriculas_existentes.add(matricula)

    def remover_linha(self, frame):
        self.linhas = [l for l in self.linhas if l[0] != frame]
        frame.destroy()

    def reset_unificar(self):
        for l in self.linhas:
            l[0].destroy()
        self.linhas.clear()
        self.matriculas_existentes.clear()
        self.contador_linhas = 0
        self.progress.set(0)

    def importar_excel(self):
        arquivo = filedialog.askopenfilename(filetypes=[("Arquivos Excel", "*.xlsx;*.xls;*.xlsm")])
        if not arquivo:
            return

        aba = simpledialog.askstring("Aba da planilha", "Digite o nome da aba:")
        if not aba:
            return

        df = pd.read_excel(arquivo, sheet_name=aba, dtype=str)
        for _, row in df.iterrows():
            self.adicionar_linha(row["Matrícula"], row["Nome PDF"])

    def unificar_thread(self):
        threading.Thread(target=self.unificar, daemon=True).start()

    def unificar(self):
        pasta = self.entry_pasta.get()
        total = len(self.linhas)

        for i, (_, mat, out, status) in enumerate(self.linhas, start=1):
            matricula = mat.get()
            nome = out.get()

            pdfs = []
            for r, _, files in os.walk(pasta):
                for f in files:
                    if matricula in f and f.lower().endswith(".pdf"):
                        pdfs.append(os.path.join(r, f))

            if not pdfs:
                status.configure(text="🔴")
                continue

            writer = PdfWriter()
            for pdf in pdfs:
                reader = PdfReader(pdf)
                for page in reader.pages:
                    writer.add_page(page)

            with open(os.path.join(pasta, f"{nome}.pdf"), "wb") as f:
                writer.write(f)

            status.configure(text="🟢")
            self.progress.set(i / total)


# EXECUÇÃO

class App(TkinterDnD.Tk):
    def __init__(self):
        super().__init__()
        self.withdraw()
        SplashScreen(self, self.load_app)
        self.update()

    def load_app(self):
        for i in range(20):
            yield (i + 1) / 20
        self.deiconify()
        self.title("Ferramentas PDF")
        self.geometry("1000x720")
        PDFToolApp(self)

if __name__ == "__main__":
    App().mainloop()
